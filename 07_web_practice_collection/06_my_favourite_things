<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Favourite Things ♡</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f8eff9;
            font-family: 'DM Sans', sans-serif;
            color: #594b65;
            padding: 45px 20px;
        }

        .page {
            max-width: 800px;
            margin: auto;
            background: #fffafd;
            padding: 45px;
            border-radius: 28px;
            position: relative;
            box-shadow: 0 10px 35px rgba(115, 83, 130, 0.08);
        }

        .sticker {
            position: absolute;
            font-size: 30px;
        }

        .sticker-one {
            top: 25px;
            right: 30px;
            transform: rotate(15deg);
        }

        .sticker-two {
            top: 190px;
            left: 15px;
            transform: rotate(-15deg);
        }

        .sticker-three {
            bottom: 25px;
            right: 25px;
            transform: rotate(12deg);
        }

        .header {
            text-align: center;
            padding: 15px 15px 35px;
        }

        .eyebrow {
            color: #b18cbd;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            margin-bottom: 15px;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            color: #795e89;
            margin-bottom: 12px;
        }

        .subtitle {
            color: #a393aa;
            font-size: 14px;
        }

        .decoration {
            color: #d6a7c6;
            margin-top: 17px;
            letter-spacing: 8px;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            color: #795e89;
            margin-bottom: 20px;
        }

        .favourites {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .card {
            padding: 23px;
            min-height: 145px;
            border-radius: 20px;
            background: #f5edfa;
            transition: transform 0.25s ease;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card:nth-child(2) {
            background: #fff0f3;
        }

        .card:nth-child(3) {
            background: #eff1ff;
        }

        .card:nth-child(4) {
            background: #fff4e9;
        }

        .card-icon {
            font-size: 28px;
            margin-bottom: 12px;
        }

        .card h2 {
            font-size: 16px;
            margin-bottom: 7px;
            color: #695475;
        }

        .card p {
            font-size: 13px;
            color: #a092a9;
        }

        .footer {
            text-align: center;
            border-top: 1px solid #f0e6f1;
            margin-top: 35px;
            padding-top: 22px;
            color: #b19bb8;
            font-size: 12px;
        }

        @media (max-width: 550px) {
            body {
                padding: 20px 12px;
            }

            .page {
                padding: 30px 20px;
            }

            h1 {
                font-size: 32px;
            }

            .favourites {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <main class="page">

        <div class="sticker sticker-one">🎀</div>
        <div class="sticker sticker-two">✿</div>
        <div class="sticker sticker-three">🍓</div>

        <header class="header">
            <p class="eyebrow">A LITTLE COLLECTION OF JOY</p>

            <h1>My Favourite Things</h1>

            <p class="subtitle">
                Here are a few things that I love!
            </p>

            <div class="decoration">✧ · ˚ · ✧</div>
        </header>

        <section>
            <h2 class="section-title">Things I love...</h2>

            <div class="favourites">

                <div class="card">
                    <div class="card-icon">🌷</div>
                    <h2>Favourite Colour</h2>
                    <p>Pastel Pink</p>
                </div>

                <div class="card">
                    <div class="card-icon">🍰</div>
                    <h2>Favourite Food</h2>
                    <p>Chocolate Cake</p>
                </div>

                <div class="card">
                    <div class="card-icon">🎧</div>
                    <h2>Favourite Music</h2>
                    <p>Soft and peaceful music</p>
                </div>

                <div class="card">
                    <div class="card-icon">📸</div>
                    <h2>Favourite Hobby</h2>
                    <p>Photography</p>
                </div>

            </div>
        </section>

        <footer class="footer">
            Made with love ♡
        </footer>

    </main>

</body>
</html>